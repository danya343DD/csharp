<Window x:Class="TextEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Текстовый редактор" Height="500" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Меню -->
        <Menu Grid.Row="0">
            <MenuItem Header="Файл">
                <MenuItem Header="Новый" Click="NewFile_Click" 
                          InputGestureText="Ctrl+N"/>
                <MenuItem Header="Открыть" Click="OpenFile_Click" 
                          InputGestureText="Ctrl+O"/>
                <MenuItem Header="Сохранить" Click="SaveFile_Click" 
                          InputGestureText="Ctrl+S"/>
                <MenuItem Header="Сохранить как..." Click="SaveAsFile_Click" 
                          InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>

            <MenuItem Header="Правка">
                <MenuItem Header="Отменить" Click="Undo_Click" 
                          InputGestureText="Ctrl+Z"/>
                <Separator/>
                <MenuItem Header="Вырезать" Click="Cut_Click" 
                          InputGestureText="Ctrl+X"/>
                <MenuItem Header="Копировать" Click="Copy_Click" 
                          InputGestureText="Ctrl+C"/>
                <MenuItem Header="Вставить" Click="Paste_Click" 
                          InputGestureText="Ctrl+V"/>
                <Separator/>
                <MenuItem Header="Выделить всё" Click="SelectAll_Click" 
                          InputGestureText="Ctrl+A"/>
            </MenuItem>

            <MenuItem Header="Формат">
                <MenuItem Header="Настройки редактора..." 
                          Click="Settings_Click"/>
            </MenuItem>
        </Menu>

        <!-- Панель инструментов -->
        <ToolBar Grid.Row="1" Margin="2">
            <Button Content="Новый" Click="NewFile_Click" 
                    Margin="1" Width="60"/>
            <Button Content="Открыть" Click="OpenFile_Click" 
                    Margin="1" Width="60"/>
            <Button Content="Сохранить" Click="SaveFile_Click" 
                    Margin="1" Width="60"/>
            <Separator/>
            <Button Content="Копировать" Click="Copy_Click" 
                    Margin="1" Width="70"/>
            <Button Content="Вырезать" Click="Cut_Click" 
                    Margin="1" Width="60"/>
            <Button Content="Вставить" Click="Paste_Click" 
                    Margin="1" Width="60"/>
            <Button Content="Отменить" Click="Undo_Click" 
                    Margin="1" Width="60"/>
            <Separator/>
            <Button Content="Настройки" Click="Settings_Click" 
                    Margin="1" Width="70"/>
        </ToolBar>

        <!-- Текстовое поле -->
        <TextBox x:Name="EditorTextBox" Grid.Row="2" 
                 Margin="5" 
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontSize="14"
                 ContextMenuOpening="EditorTextBox_ContextMenuOpening">
            <TextBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Копировать" Click="Copy_Click"/>
                    <MenuItem Header="Вырезать" Click="Cut_Click"/>
                    <MenuItem Header="Вставить" Click="Paste_Click"/>
                    <Separator/>
                    <MenuItem Header="Отменить" Click="Undo_Click"/>
                </ContextMenu>
            </TextBox.ContextMenu>
        </TextBox>

        <!-- Строка состояния -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готов"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="PositionText" Text="Строка: 1, Столбец: 1"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>