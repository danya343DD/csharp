<Window x:Class="FileExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проводник" Height="550" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Меню -->
        <Menu Grid.Row="0">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть" Click="Open_Click" 
                          InputGestureText="Enter"/>
                <MenuItem Header="Создать папку" Click="CreateFolder_Click" 
                          InputGestureText="Ctrl+N"/>
                <Separator/>
                <MenuItem Header="Выход" Click="Exit_Click" 
                          InputGestureText="Alt+F4"/>
            </MenuItem>

            <MenuItem Header="Вид">
                <MenuItem Header="Крупные значки" 
                          Click="ViewMode_Click" Tag="Large"/>
                <MenuItem Header="Мелкие значки" 
                          Click="ViewMode_Click" Tag="Small"/>
                <MenuItem Header="Список" 
                          Click="ViewMode_Click" Tag="List"/>
                <MenuItem Header="Таблица" 
                          Click="ViewMode_Click" Tag="Details"/>
            </MenuItem>
        </Menu>

        <!-- Панель инструментов и адресная строка -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Кнопки навигации -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" 
                        Margin="0,0,0,5">
                <Button Content="◀ Назад" Click="Back_Click" 
                        Width="70" Margin="0,0,5,0"/>
                <Button Content="Вверх ▲" Click="Up_Click" 
                        Width="70" Margin="0,0,5,0"/>
                <Button Content="Обновить" Click="Refresh_Click" 
                        Width="80"/>
            </StackPanel>

            <!-- Адресная строка -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Адрес:" VerticalAlignment="Center" 
                           Margin="0,0,5,0" Grid.Column="0"/>
                <TextBox x:Name="AddressBox" Grid.Column="1" 
                         KeyDown="AddressBox_KeyDown"/>
            </Grid>
        </Grid>

        <!-- Основная область -->
        <Grid Grid.Row="2" Margin="5,0,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Дерево папок -->
            <GroupBox Grid.Column="0" Header="Папки">
                <TreeView x:Name="FolderTree" 
                          SelectedItemChanged="FolderTree_SelectedItemChanged"
                          MouseDoubleClick="FolderTree_MouseDoubleClick">
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Открыть" 
                                      Click="TreeOpen_Click"/>
                            <MenuItem Header="Создать папку" 
                                      Click="CreateFolder_Click"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="5" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch"/>

            <!-- Содержимое папки -->
            <GroupBox Grid.Column="2" Header="Содержимое">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListView x:Name="FileListView" 
                              Grid.Row="0"
                              MouseDoubleClick="FileListView_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Имя" Width="200"/>
                                <GridViewColumn Header="Тип" Width="80"/>
                                <GridViewColumn Header="Размер" Width="100"/>
                                <GridViewColumn Header="Изменён" Width="150"/>
                            </GridView>
                        </ListView.View>

                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть" 
                                          Click="Open_Click"/>
                                <MenuItem Header="Копировать" 
                                          Click="CopyFile_Click"/>
                                <MenuItem Header="Удалить" 
                                          Click="DeleteFile_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>

                    <!-- Строка состояния -->
                    <StatusBar Grid.Row="1">
                        <TextBlock x:Name="ItemCountText" 
                                   Text="Элементов: 0"/>
                    </StatusBar>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>